---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Home"
  description="Personal site and blog."
>
  <!-- Hero -->
  <section class="mb-20 sm:mb-24 pt-4 sm:pt-8">
    <h1 class="animate-fade-up text-5xl sm:text-6xl font-bold mb-4 leading-[1.1] tracking-tight text-text">
      Hey, I'm <span class="text-accent">Phillip</span> 👋
    </h1>
    <p class="animate-fade-up-delay-1 text-xl sm:text-2xl leading-relaxed mb-8 max-w-prose text-muted font-light">
      I'm a developer who writes about software, tools, and whatever I'm currently building.
    </p>
    <div class="animate-fade-up-delay-2 flex flex-wrap gap-3">
      <a
        href="/blog/"
        class="btn-press px-6 py-3 min-h-[48px] inline-flex items-center rounded-lg text-base font-semibold no-underline bg-accent hover:opacity-90 text-white shadow-sm"
      >
        Read the blog
      </a>
      <a
        href="/about/"
        class="btn-press px-6 py-3 min-h-[48px] inline-flex items-center rounded-lg text-base font-medium no-underline border border-border text-text hover:bg-surface"
      >
        About me
      </a>
    </div>
  </section>

  <!-- Recent posts -->
  {posts.length > 0 && (
    <section class="animate-fade-up-delay-3">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">Recent posts</h2>
        <a
          href="/blog/"
          class="text-sm font-medium no-underline text-accent hover:opacity-75"
        >
          All posts &rarr;
        </a>
      </div>
      <div class="flex flex-col divide-y divide-border">
        {posts.map((post, i) => (
          <div class="animate-stagger" style={`--stagger-index: ${i}`}>
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.id}
              tags={post.data.tags}
            />
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
