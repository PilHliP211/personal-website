---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = [
  // Add your projects here. Example shape:
  // {
  //   title: 'Project Name',
  //   description: 'What it does and why it matters.',
  //   url: 'https://github.com/PilHliP211/project',
  //   tags: ['TypeScript', 'CLI'],
  // },
];
---

<BaseLayout
  title="Home"
  description="Phillip Byram — developer building applications and tools for the web."
>
  <!-- Hero -->
  <section class="mb-20 sm:mb-24 pt-4 sm:pt-8">
    <div class="flex items-center gap-4 mb-6">
      <img
        src="/avatar.jpg"
        alt="Phillip Byram"
        class="w-14 h-14 sm:w-16 sm:h-16 rounded-full ring-2 ring-border shrink-0 bg-surface"
        onerror="this.style.display='none'"
      />
      <div>
        <h1 class="animate-fade-up text-3xl sm:text-4xl font-bold leading-tight tracking-tight text-text">
          Phillip Byram
        </h1>
        <p class="animate-fade-up-delay-1 text-sm text-muted mt-1">Developer &middot; Building for the web</p>
      </div>
    </div>

    <p class="animate-fade-up-delay-1 text-base sm:text-lg leading-relaxed mb-8 max-w-prose text-muted">
      I build applications and tools, and write about software, systems, and whatever I'm working on.
    </p>

    <div class="animate-fade-up-delay-2 flex flex-wrap gap-3">
      <a
        href="/projects/"
        class="btn-press px-5 py-2.5 min-h-[44px] inline-flex items-center rounded-md text-sm font-medium no-underline bg-text text-bg transition-colors hover:opacity-90"
      >
        View projects
      </a>
      <a
        href="/blog/"
        class="btn-press px-5 py-2.5 min-h-[44px] inline-flex items-center rounded-md text-sm font-medium no-underline border border-border text-text hover:bg-surface transition-colors"
      >
        Read the blog
      </a>
    </div>
  </section>

  <!-- Featured projects -->
  {projects.length > 0 && (
    <section class="mb-20 animate-fade-up-delay-3">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-sm font-medium uppercase tracking-widest text-muted">Projects</h2>
        <a
          href="/projects/"
          class="text-sm font-medium no-underline text-muted hover:text-text transition-colors"
        >
          All projects &rarr;
        </a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {projects.slice(0, 4).map((project, i) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card-hover block no-underline rounded-lg p-4 border border-border hover:border-muted"
            style={`--stagger-index: ${i}`}
          >
            <h3 class="text-sm font-semibold mb-1 text-text">{project.title}</h3>
            <p class="text-sm text-muted line-clamp-2">{project.description}</p>
            {project.tags && (
              <div class="flex flex-wrap gap-1.5 mt-3">
                {project.tags.map((tag) => (
                  <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-surface text-muted">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Recent posts -->
  {posts.length > 0 && (
    <section class="animate-fade-up-delay-3">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-sm font-medium uppercase tracking-widest text-muted">Writing</h2>
        <a
          href="/blog/"
          class="text-sm font-medium no-underline text-muted hover:text-text transition-colors"
        >
          All posts &rarr;
        </a>
      </div>
      <div class="flex flex-col divide-y divide-border">
        {posts.map((post, i) => (
          <div class="animate-stagger" style={`--stagger-index: ${i}`}>
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.id}
              tags={post.data.tags}
            />
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
