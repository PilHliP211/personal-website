---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Home"
  description="Personal site and blog."
>
  <!-- Hero -->
  <section class="mb-16">
    <h1 class="text-4xl sm:text-5xl font-bold mb-4 leading-tight text-text">
      Hey, I'm <span class="text-accent">Phillip</span> 👋
    </h1>
    <p class="text-lg leading-relaxed mb-6 max-w-prose text-muted">
      I'm a developer who writes about software, tools, and whatever I'm currently building.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href="/blog/"
        class="px-4 py-2 rounded-lg text-sm font-medium no-underline bg-accent hover:opacity-90 text-white transition-colors"
      >
        Read the blog
      </a>
      <a
        href="/about/"
        class="px-4 py-2 rounded-lg text-sm font-medium no-underline transition-colors bg-border text-text"
      >
        About me
      </a>
    </div>
  </section>

  <!-- Recent posts -->
  {posts.length > 0 && (
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-text">Recent posts</h2>
        <a
          href="/blog/"
          class="text-sm font-medium no-underline text-muted"
        >
          All posts &rarr;
        </a>
      </div>
      <div class="flex flex-col divide-y divide-border">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
