---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS } from '../../data/projects';
import { ROUTES } from '../../data/routes';

const page = ROUTES.projects;
---

<BaseLayout
  title={page.title}
  description={page.description}
>
  <header class="mb-12 pt-4 sm:pt-8">
    <h1 class="text-3xl sm:text-4xl font-bold mb-3 tracking-tight text-text">Projects</h1>
    <p class="text-base text-muted">
      A few projects spanning product work, automation, and the web.
    </p>
  </header>

  {PROJECTS.length > 0 && (
    <div class="grid gap-3 sm:grid-cols-2">
      {PROJECTS.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover btn-press block no-underline rounded-lg p-4 border border-border hover:border-muted"
        >
          <h2 class="text-sm font-semibold mb-1 text-text">
            {project.title}
          </h2>
          <p class="text-sm text-muted line-clamp-2">
            {project.description}
          </p>
          {project.tags && (
            <div class="flex flex-wrap gap-1.5 mt-3">
              {project.tags.map((tag) => (
                <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-surface text-muted">
                  {tag}
                </span>
              ))}
            </div>
          )}
          <span class="sr-only">Opens in a new tab.</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
