---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
---

<BaseLayout
  title="About"
  description="A little about me — who I am, what I work on, and how to get in touch."
>
  <article class="prose prose-lg max-w-none">
    <h1>About</h1>

    <!--
      Replace everything in this section with your own content.
      The page uses the .prose class for readable typography.
    -->

    <p>
      Hi! I'm <strong>Phillip</strong> — a developer based somewhere on Earth.
      I work on [what you work on]. This is my personal site where I write about
      things I'm learning, building, or thinking about.
    </p>

    <h2>What I'm working on</h2>
    <p>
      [Describe your current projects, job, or interests here.]
    </p>

    <h2>Stack &amp; tools</h2>
    <ul>
      <li>[Language / framework you use most]</li>
      <li>[Editor / tooling]</li>
      <li>[Anything else worth mentioning]</li>
    </ul>

    <h2>Get in touch</h2>
    <p>
      The best way to reach me is [email / GitHub / wherever].
      I'm always happy to talk about [topics you care about].
    </p>
  </article>
</BaseLayout>
