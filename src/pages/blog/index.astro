---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { ROUTES } from '../../data/routes';
import { getPublishedBlogPosts } from '../../lib/content';

const page = ROUTES.blog;
const posts = await getPublishedBlogPosts();
---

<BaseLayout
  title={page.title}
  description={page.description}
>
  <header class="mb-12 pt-4 sm:pt-8">
    <h1 class="text-3xl sm:text-4xl font-bold mb-3 tracking-tight text-text">Blog</h1>
    <p class="text-sm text-muted">
      {posts.length} post{posts.length !== 1 ? 's' : ''} on software, tools, and systems.
    </p>
  </header>

  {posts.length === 0 ? (
    <p class="text-muted">No posts yet. Check back soon.</p>
  ) : (
    <div class="flex flex-col divide-y divide-border">
      {posts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.id}
          tags={post.data.tags}
        />
      ))}
    </div>
  )}
</BaseLayout>
