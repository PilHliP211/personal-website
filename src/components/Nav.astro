---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav aria-label="Main navigation">
  <ul class="flex items-center gap-1 sm:gap-2 list-none p-0 m-0">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class:list={[
            'px-3 py-1.5 rounded-md text-sm font-medium no-underline transition-colors duration-150',
            isActive(href)
              ? 'bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300'
              : 'hover:bg-gray-100 dark:hover:bg-slate-800',
          ]}
          style={!isActive(href) ? 'color: rgb(var(--color-muted))' : undefined}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>
