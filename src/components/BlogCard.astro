---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group">
  <a
    href={`/blog/${slug}/`}
    class="block no-underline rounded-xl p-5 -mx-5 transition-colors duration-150 hover:bg-gray-50 dark:hover:bg-slate-800/50"
  >
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <h2
          class="text-lg font-semibold mb-1 truncate group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"
          style="color: rgb(var(--color-text))"
        >
          {title}
        </h2>
        <p class="text-sm line-clamp-2 mb-3" style="color: rgb(var(--color-muted))">
          {description}
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <time
            class="text-xs"
            datetime={pubDate.toISOString()}
            style="color: rgb(var(--color-muted))"
          >
            {formattedDate}
          </time>
          {tags.length > 0 && (
            <span style="color: rgb(var(--color-muted))">·</span>
          )}
          {tags.slice(0, 3).map((tag) => (
            <span
              class="text-xs px-2 py-0.5 rounded-full"
              style="background-color: rgb(var(--color-border)); color: rgb(var(--color-muted))"
            >
              {tag}
            </span>
          ))}
        </div>
      </div>
      <span
        class="text-lg mt-0.5 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
        aria-hidden="true"
        style="color: rgb(var(--color-muted))"
      >→</span>
    </div>
  </a>
</article>
