---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group">
  <a
    href={`/blog/${slug}/`}
    class="block no-underline rounded-xl py-5 px-5 -mx-5 transition-colors duration-150 hover:bg-surface"
  >
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <h2
          class="text-base font-semibold mb-1.5 truncate text-text group-hover:text-accent transition-colors"
        >
          {title}
        </h2>
        <p class="text-sm leading-relaxed line-clamp-2 mb-3 text-muted">
          {description}
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <time
            class="text-xs text-muted"
            datetime={pubDate.toISOString()}
          >
            {formattedDate}
          </time>
          {tags.length > 0 && (
            <span class="text-muted">&middot;</span>
          )}
          {tags.slice(0, 3).map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded-full bg-border text-muted">
              {tag}
            </span>
          ))}
        </div>
      </div>
      <span
        class="text-lg mt-0.5 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity text-muted"
        aria-hidden="true"
      >&rarr;</span>
    </div>
  </a>
</article>
