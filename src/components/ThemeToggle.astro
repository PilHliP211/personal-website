<!--
  Theme toggle — vanilla JS only, no framework island needed.
  The <script> block is bundled by Vite and runs on the client.
-->
<button
  id="theme-toggle"
  aria-label="Switch to dark mode"
  class="p-2.5 min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-lg transition-colors duration-150 text-muted hover:bg-surface"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg
    id="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hidden"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>

  <!-- Moon icon (shown in light mode) -->
  <svg
    id="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<!-- Live region for screen reader announcements -->
<span id="theme-announce" class="sr-only" aria-live="polite" role="status"></span>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    const iconSun = document.getElementById('icon-sun');
    const iconMoon = document.getElementById('icon-moon');
    const announce = document.getElementById('theme-announce');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      iconSun?.classList.toggle('hidden', !isDark);
      iconMoon?.classList.toggle('hidden', isDark);
      btn?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
    }

    updateIcons();

    btn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();

      // Announce the change to screen readers
      if (announce) {
        announce.textContent = isDark ? 'Dark mode enabled' : 'Light mode enabled';
      }
    });
  }

  // Run on initial load and after Astro view transitions
  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
