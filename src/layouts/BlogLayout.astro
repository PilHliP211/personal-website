---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: string;
}

const { title, description, pubDate, updatedDate, tags = [], heroImage } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title={title} description={description} ogImage={heroImage}>
  <article>
    <header class="mb-10">
      <a
        href="/blog/"
        class="text-sm font-medium no-underline mb-6 inline-flex items-center gap-1 text-muted"
      >
        &larr; All posts
      </a>

      {heroImage && (
        <img
          src={heroImage}
          alt=""
          class="w-full rounded-xl mb-8 aspect-[2/1] object-cover"
        />
      )}

      <h1 class="text-3xl sm:text-4xl font-bold mb-4 leading-tight tracking-tight text-text">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-sm text-muted">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <span>
            &middot; Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
          </span>
        )}
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-surface text-muted">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-theme prose-lg max-w-none leading-relaxed">
      <slot />
    </div>

    <footer class="mt-16 pt-8 border-t border-border">
      <a
        href="/blog/"
        class="text-sm font-medium no-underline text-muted"
      >
        &larr; Back to all posts
      </a>
    </footer>
  </article>
</BaseLayout>
